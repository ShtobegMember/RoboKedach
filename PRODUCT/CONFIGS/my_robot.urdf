<robot name="my_robot">

  <link name="base_link" />

  <link name="laser_frame" />

  <link name="imu_link" />

  <joint name="base_to_laser" type="fixed">
    <parent link="base_link" />
    <child link="laser_frame" />
    <origin xyz="0 0.04615 0.0596" rpy="0 0 0" />
  </joint>

  <joint name="base_to_imu" type="fixed">
    <parent link="base_link" />
    <child link="imu_link" />
    <origin xyz="0.0354 -0.02815 0.042" rpy="0 0 0" />
  </joint>

</robot>
